{
  "name": "night-market",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run build && npm run start -w server",
    "typecheck": "npm run typecheck --workspaces",
    "db:reset": "npm run db:reset -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
